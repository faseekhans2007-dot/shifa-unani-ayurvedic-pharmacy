{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Registered patient profile containing credentials and personal metrics.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "age": { "type": "integer" },
        "gender": { "type": "string" },
        "bloodGroup": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "email"]
    },
    "Appointment": {
      "title": "Clinical Appointment",
      "description": "Pre-booked clinical doctor checkup appointment tied to a authenticated user.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "patientName": { "type": "string" },
        "patientPhone": { "type": "string" },
        "patientEmail": { "type": "string" },
        "doctorId": { "type": "string" },
        "doctorName": { "type": "string" },
        "departmentId": { "type": "string" },
        "departmentName": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "status": { "type": "string", "enum": ["Scheduled", "Completed", "Cancelled"] },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "patientName", "patientPhone", "patientEmail", "doctorId", "doctorName", "departmentId", "departmentName", "date", "time", "status", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Stores individual authenticated accounts and patient credentials."
    },
    "bookings/{bookingId}": {
      "schema": "Appointment",
      "description": "Clinical booking slots reserved by users."
    }
  }
}
